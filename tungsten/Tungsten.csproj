<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TUNGSTEN  =  the engine itself.
    It is compiled as a class LIBRARY (not an .exe) because it acts as a *client* -
    something that gets hosted by the "studio" editor process during edit-time,
    and could equally be hosted by a bare "player.exe" at run-time (not included
    here, but the separation is what makes that possible later).
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Tungsten</RootNamespace>
    <AssemblyName>Tungsten</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenTK gives us: GL bindings, a GLFW-backed GameWindow, input, and math (Vector3/Matrix4/Quaternion). -->
    <PackageReference Include="OpenTK" Version="4.8.2" />
    <!-- Texture.cs lives in this project (tungsten/Rendering), so the image
         loader has to be referenced here too, not just in Studio.csproj. -->
    <PackageReference Include="StbImageSharp" Version="2.27.13" />
  </ItemGroup>

</Project>
